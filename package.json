{
  "name": "yeye-desktop-pet-clock",
  "version": "1.0.0",
  "description": "Windows desktop clock, alarm and interactive desktop pet",
  "main": "src/main.js",
  "author": "Codex",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack:win": "electron-builder --win portable --x64",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yeye.desktopclock",
    "productName": "椰椰桌面时钟",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/pet.png",
      "assets/pet-cute-body.png",
      "assets/pet-cute-left-arm.png",
      "assets/pet-cute-right-arm.png",
      "assets/sun-reference.png",
      "assets/moon-reference.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-安装版.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "椰椰桌面时钟"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-免安装版.${ext}"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
